# Optional. Any webhook (Slack, Zapier, Make, n8n, Google Apps Script...) that should receive
# "Request a call" submissions as JSON. Without it, requests only appear in the Vercel logs.
LEAD_WEBHOOK_URL=

# Status pages (/status). Base URL of the status API (see docs/DOCUMENTATION.md, "Status pages").
# Also add this origin to connect-src in vercel.json.
VITE_STATUS_API_URL=
# Set to true to show built-in SAMPLE data on a deployed site (previews only, never in production).
VITE_STATUS_USE_MOCK=
